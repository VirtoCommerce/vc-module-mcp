  <requireLicenseAcceptance>false</requireLicenseAcceptance>

  <assemblyFile>VirtoCommerce.MCP.Web.dll</assemblyFile>
  <moduleType>VirtoCommerce.MCP.Web.Module, VirtoCommerce.MCP.Web</moduleType>
