<?xml version="1.0" encoding="utf-8"?>
<module>
  <id>VirtoCommerce.MCP.MarketingExtensionSample</id>
  <version>3.1000.0</version>
  <version-tag></version-tag>

  <platformVersion>3.1085.0</platformVersion>
  <dependencies>
    <dependency id="VirtoCommerce.MCP" version="3.1000.0" />
    <!-- The module it extends. The dependency makes the platform initialize this module after it, so the overrides win. -->
    <dependency id="VirtoCommerce.MCP.MarketingSample" version="3.1000.0" />
  </dependencies>

  <title>MCP Marketing Extension Sample</title>
  <description>Sample client module that extends the MCP marketing sample without changing it: an extended promotion model, company finance and margin rules, extra tools, a prompt and a resource.</description>

  <authors>
    <author>VirtoCommerce</author>
  </authors>
  <owners>
    <owner>Virto Commerce</owner>
  </owners>

  <projectUrl>https://github.com/VirtoCommerce/vc-module-mcp</projectUrl>
  <requireLicenseAcceptance>false</requireLicenseAcceptance>

  <assemblyFile>VirtoCommerce.MCP.MarketingExtensionSample.dll</assemblyFile>
  <moduleType>VirtoCommerce.MCP.MarketingExtensionSample.Module, VirtoCommerce.MCP.MarketingExtensionSample</moduleType>

  <releaseNotes>Sample module.</releaseNotes>
  <copyright>Copyright © 2026 Virto Commerce. All rights reserved</copyright>
  <tags>sample mcp marketing extension</tags>
  <useFullTypeNameInSwagger>false</useFullTypeNameInSwagger>
</module>
